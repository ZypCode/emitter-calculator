{
  "name": "emitter-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:offline": "vite build --config vite.offline.config.ts",
